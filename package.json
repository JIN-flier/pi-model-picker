{
  "name": "pi-daily-report",
  "version": "0.1.0",
  "private": true,
  "description": "test pi agent plugin",
  "license": "MIT",
  "author": "flier",
  "type": "module",
  "main": "index.js",
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "allowScripts": {
    "@google/genai@2.21.0": true,
    "protobufjs@7.6.6": true
  }
